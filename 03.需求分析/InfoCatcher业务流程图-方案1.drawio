        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\ntitle: InfoCatcher 业务流程图 — 方案1 范围\n---\nflowchart TB\n    start([用户进入首页])\n    nav{选择功能}\n\n    start --&gt; nav\n    start --&gt; list[浏览工具列表]\n\n    nav -- 工具库 --&gt; multi[多类型筛选搜索]\n    multi --&gt; list\n\n    nav -- 场景导航 --&gt; scene[按场景查看推荐]\n    nav -- 定期推荐 --&gt; recom[浏览近期精选]\n\n    scene --&gt; search[搜索 / 筛选]\n    recom --&gt; search\n    search --&gt; list\n\n    nav -- AI概念词典 --&gt; glossary[分类浏览或搜索AI术语]\n    nav -- 对比模式 --&gt; compare[查看已勾选的对比]\n\n    list --&gt; card[点击卡片查看工具详情]\n    card --&gt; add[勾选加入对比]\n    add --&gt; compare\n\n    glossary --&gt; term[输入关键词搜索术语]\n    term --&gt; glossary\n\n    card --&gt; list\n    compare --&gt; decide{信息满足需求？}\n    decide -- 是 --&gt; exit([获取结果 / 离开])\n    decide -- 否 --&gt; nav\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="37">
