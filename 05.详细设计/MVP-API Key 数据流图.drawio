        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    subgraph GitHub[\&quot;GitHub 平台\&quot;]\n        Secrets[(\&quot;🔐 GitHub&lt;br/&gt;Repository Secrets&lt;br/&gt;&lt;b&gt;YOUTUBE_API_KEY&lt;/b&gt;&lt;br/&gt;&lt;b&gt;X_API_KEY&lt;/b&gt;\&quot;)]\n        Actions[\&quot;⚙️ GitHub Actions&lt;br/&gt;collect-news.yml\&quot;]\n        Repo[(\&quot;📦 代码仓库\&quot;)]\n        Pages[\&quot;🌐 GitHub Pages&lt;br/&gt;静态站点\&quot;]\n    end\n\n    subgraph Runner[\&quot;GitHub Actions Runner (临时 Ubuntu 虚拟机)\&quot;]\n        Env[\&quot;📥 注入环境变量&lt;br/&gt;&lt;code&gt;process.env.YOUTUBE_API_KEY&lt;/code&gt;&lt;br/&gt;&lt;code&gt;process.env.X_API_KEY&lt;/code&gt;\&quot;]\n        Script[\&quot;📜 Node.js 构建脚本&lt;br/&gt;build-news.js\&quot;]\n    end\n\n    subgraph External[\&quot;外部平台 API\&quot;]\n        YouTube[\&quot;▶️ YouTube Data API&lt;br/&gt;&lt;code&gt;?key=YOUR_API_KEY&lt;/code&gt;\&quot;]\n        X[\&quot;𝕏 X (Twitter) API&lt;br/&gt;&lt;code&gt;X-API-Key Header&lt;/code&gt;\&quot;]\n        Bilibili[\&quot;📺 Bilibili RSS&lt;br/&gt;(无需 API Key)\&quot;]\n    end\n\n    subgraph Frontend[\&quot;浏览器前端\&quot;]\n        AppJS[\&quot;📄 app.js&lt;br/&gt;读取静态 JSON\&quot;]\n        HotJSON[(\&quot;📊 data/hotspots.json&lt;br/&gt;data/news-state.json&lt;br/&gt;等等\&quot;)]\n    end\n\n    Secrets --&gt;|\&quot;&lt;code&gt;${{ secrets.YOUTUBE_API_KEY }}&lt;/code&gt;\&quot;| Actions\n    Secrets --&gt;|\&quot;&lt;code&gt;${{ secrets.X_API_KEY }}&lt;/code&gt;\&quot;| Actions\n    Actions --&gt;|\&quot;设定环境变量\&quot;| Env\n    Env --&gt;|\&quot;&lt;code&gt;process.env.YOUTUBE_API_KEY&lt;/code&gt;\&quot;| Script\n    Env --&gt;|\&quot;&lt;code&gt;process.env.X_API_KEY&lt;/code&gt;\&quot;| Script\n    Script --&gt;|\&quot;HTTPS ?key=API_KEY\&quot;| YouTube\n    Script --&gt;|\&quot;HTTPS X-API-Key Header\&quot;| X\n    Script --&gt;|\&quot;HTTPS RSS\&quot;| Bilibili\n    YouTube --&gt;|\&quot;返回 JSON 数据\&quot;| Script\n    X --&gt;|\&quot;返回 JSON 数据\&quot;| Script\n    Bilibili --&gt;|\&quot;返回 RSS 数据\&quot;| Script\n    Script --&gt;|\&quot;生成静态 JSON\&quot;| Repo\n    Repo --&gt;|\&quot;git push\&quot;| Pages\n    Pages --&gt;|\&quot;HTTP 静态资源\&quot;| AppJS\n    AppJS --&gt;|\&quot;fetch 读取\&quot;| HotJSON\n\n    style Secrets fill:#FEE2E2,stroke:#DC2626,stroke-width:2px\n    style Env fill:#FEF3C7,stroke:#F59E0B\n    style Script fill:#DBEAFE,stroke:#3B82F6\n    style YouTube fill:#ECFDF5,stroke:#10B981\n    style X fill:#F5F3FF,stroke:#8B5CF6\n    style AppJS fill:#F0FDF4,stroke:#22C55E\n    style HotJSON fill:#F0FDF4,stroke:#22C55E\n    style Actions fill:#FEF3C7,stroke:#F59E0B\n\n    classDef noKey fill:#F0FDF4,stroke:#22C55E,stroke-dasharray: 5 5\n    classDef hasKey fill:#FEE2E2,stroke:#DC2626\n    classDef transit fill:#FEF3C7,stroke:#F59E0B\n\n    class AppJS,HotJSON,Pages noKey\n    class Secrets,Env hasKey\n    class Actions,Script transit\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="32">
