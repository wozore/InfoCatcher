<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram id="data-flow-hotspot" name="热点数据链路">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" value="&lt;b&gt;原始数据&lt;/b&gt;&lt;br&gt;外部平台 API 原始响应（YouTube / X / Bilibili-RSSHub）&lt;br&gt;处理: news-youtube / news-x / news-bilibili 采集&lt;br&gt;来源清单 news-sources.json + 配置 news-config.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe8e8;strokeColor=#d66;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="220" y="20" width="460" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;内容条目（标准内容模型）&lt;/b&gt;&lt;br&gt;处理: feed-parser.js:normalizeRssItem / news-x.js:normalizeTweet&lt;br&gt;id, platform, native_id, source_type, url, title,&lt;br&gt;description(截断600), published_at, fetched_at, author_id, author_name,&lt;br&gt;source_id, language, source_tags, thumbnail,&lt;br&gt;metrics{views,likes,comments,reposts,replies}, explicit_links(≤10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3d6;strokeColor=#d9a032;fontSize=11;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="220" y="160" width="460" height="135" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;核心状态（registry / scheduler / quota）&lt;/b&gt;&lt;br&gt;处理: news-registry.js 双轴状态机 · news-scheduler.js 时间层 · news-quota.js 额度&lt;br&gt;条目不新增内容字段，仅在 registry 建立去重与状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#cc7a2d;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="220" y="350" width="460" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;条目 + 评分/主题/溯源并行数组&lt;/b&gt;&lt;br&gt;处理: scoring.js:assessItem / projection.js:buildEvents·buildProvenance·dedupeItems&lt;br&gt;assessments[]: content_id, score_breakdown{5项}, final_score, confidence,&lt;br&gt;commercial_assessment, anomaly_assessment, official_cross_check, evidence&lt;br&gt;events[]: 主题聚合&lt;br&gt;provenance[]: 溯源 original/repost/citation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e0ff;strokeColor=#7b68d6;fontSize=11;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="220" y="470" width="460" height="125" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;条目带 AI 产物（契约字段，默认全关）&lt;/b&gt;&lt;br&gt;处理: classify/content-classifier·summarizer·reviewer·localizer&lt;br&gt;分类: content_type_status, classifier, ai_confidence&lt;br&gt;总结: summary, summary_key_points&lt;br&gt;审核: ai_review{verdict,reasons,confidence}&lt;br&gt;本地化: localizations{zh:{title,description}}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6fa;strokeColor=#5f5fa8;fontSize=11;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="220" y="650" width="460" height="125" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;候选记录（完整 36 字段）→ hotspot-candidates.json&lt;/b&gt;&lt;br&gt;处理: news-candidates.js:mergeCandidates（候选层，不发布 dist/）&lt;br&gt;公开内容 22 + AI 痕迹(content_type_status/classifier...) +&lt;br&gt;审计(batch_id/candidate_version) + 双状态轴&lt;br&gt;ai_processing_status × review_status + localizations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaff;strokeColor=#2d6fcc;fontSize=11;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="220" y="830" width="460" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;合格候选（数据形态不变，仅筛选）&lt;/b&gt;&lt;br&gt;处理: news-public-gate.js + news-candidates.js:isPublicEligible&lt;br&gt;条件: ai_processing_status=completed 且 review_status=approved&lt;br&gt;+ 30 天近期窗口 + 公开字段完整" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e8ff;strokeColor=#1f5fb0;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="220" y="985" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;公开条目（22 字段）→ hotspots.json（前端唯一数据源）&lt;/b&gt;&lt;br&gt;处理: projection.js:enrichHotspotProjection + news-candidates.js:toPublicItem&lt;br&gt;(剔除 31 个 INTERNAL_FIELDS) + news-public-gate.js:filterProjectionByWindow&lt;br&gt;= 候选 − 内部字段&lt;br&gt;保留 hot_score · evidence_excerpt · related_resources · localizations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7f5d7;strokeColor=#2f9e44;fontSize=11;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="220" y="1120" width="460" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;公开数据（不变）→ dist/data/news/output/hotspots.json&lt;/b&gt;&lt;br&gt;处理: build-dist.js 原样复制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7f5d7;strokeColor=#2f9e44;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="220" y="1285" width="460" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;前端内存状态 → HTML&lt;/b&gt;&lt;br&gt;处理: data.js loadData fetch · getFilteredTrending 排序/筛选 ·&lt;br&gt;getHotspotHeat · getLocalizedField 读 localizations.zh.* · escapeHtml 转义&lt;br&gt;渲染: trending.js renderTrendingCard / openHotspotDetail&lt;br&gt;metrics 由 renderHotspotMetrics(:146) 定义但当前无调用点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ececec;strokeColor=#888;fontSize=11;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="220" y="1405" width="460" height="125" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="采集→统一模型" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="写入 registry / 状态" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n2" target="n3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="评分/主题/溯源" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n3" target="n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="AI 加工（可选）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="候选落地" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n5" target="n6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="资格筛选" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n6" target="n7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="剔除内部字段" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n7" target="n8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="构建部署" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n8" target="n9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="浏览器 fetch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n9" target="n10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
